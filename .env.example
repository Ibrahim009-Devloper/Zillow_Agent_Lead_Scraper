# comma separated, multiple accounts
GEMINI_API_KEYS=key1,key2,key3
GROQ_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Google Sheets / Drive (service account json)
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json
# Drive folder ID shared (Editor) with the service-account email
GOOGLE_PARENT_FOLDER_ID=
